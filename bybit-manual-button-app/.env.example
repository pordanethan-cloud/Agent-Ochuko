# Bybit V5 API Credentials
# NOTE: Spot trading only requires 'Spot Trade' and 'Read' permissions.
# NEVER enable 'Withdrawal' or 'Transfer' permissions for trading bots or panels.

BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# Network Mode: 'testnet' or 'mainnet'
BYBIT_ENVIRONMENT=testnet

# Server Port
PORT=8080
